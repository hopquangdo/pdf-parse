# Copy to .env (never commit it). Used by docker compose and by uvicorn when run locally.

# --- model used to read drawings ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=deepseek/deepseek-v4.1-flash
LLM_API_KEY=

# --- database (docker compose creates it; the password is yours to choose) ---
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# POSTGRES_DB=steel
# POSTGRES_USER=steel

# --- sign-in ---
# Signs the access tokens. At least 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# True whenever the site is served over HTTPS (cookies are then marked Secure)
COOKIE_SECURE=false
# First administrator, created only while the users table is empty. Must change the password at first sign-in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# ADMIN_NAME=Administrator
# ADMIN_MUST_CHANGE=true   # false only on a development machine

# --- optional ---
# BIND=127.0.0.1        # 0.0.0.0 only behind a TLS reverse proxy
# PORT=8000
# USD_VND=26000
# MAX_UPLOAD_MB=30
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=15
